generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  transactions Transaction[]
  categories   Category[]
  methods      PaymentMethod[]
  duoMemberships DuoMember[]
  dueDates     DueDate[]
  recurringPayments RecurringPayment[]
  installments Installment[]
}

enum TransactionType {
  income
  expense
}

model Duo {
  id          String      @id @default(cuid())
  code        String      @unique
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  closedAt    DateTime?
  closedById  String?
  members     DuoMember[]
  transactions Transaction[]
  categories   Category[]
  methods      PaymentMethod[]
  dueDates     DueDate[]
  recurringPayments RecurringPayment[]
  installments Installment[]
}

model DuoMember {
  id        String   @id @default(cuid())
  duoId     String
  duo       Duo      @relation(fields: [duoId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([duoId, userId])
}

model Transaction {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  duoId     String?
  duo       Duo?            @relation(fields: [duoId], references: [id], onDelete: Cascade)
  type      TransactionType
  amount    Float
  currency  String
  category  String
  date      DateTime
  method    String
  note      String?
  weekly    Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([duoId])
}

model Category {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  duoId     String?
  duo       Duo?     @relation(fields: [duoId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@unique([duoId, name])
}

model PaymentMethod {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  duoId     String?
  duo       Duo?     @relation(fields: [duoId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@unique([duoId, name])
}

model DueDate {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  duoId           String?
  duo             Duo?     @relation(fields: [duoId], references: [id], onDelete: Cascade)
  name            String
  amount          Float
  currency        String
  date            DateTime
  category        String?
  method          String?
  note            String?
  important       Boolean  @default(false)
  calendarExported Boolean @default(false)
  status          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([duoId])
}

model RecurringPayment {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  duoId           String?
  duo             Duo?     @relation(fields: [duoId], references: [id], onDelete: Cascade)
  name            String
  amount          Float
  currency        String
  frequency       String
  everyDays       Int?
  nextDate        DateTime
  durationType    String?
  durationMonths  Int?
  endDate         DateTime?
  category        String?
  method          String?
  important       Boolean  @default(false)
  calendarExported Boolean @default(false)
  status          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([duoId])
}

model Installment {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  duoId           String?
  duo             Duo?     @relation(fields: [duoId], references: [id], onDelete: Cascade)
  name            String
  amount          Float
  currency        String
  total           Int
  current         Int
  nextDate        DateTime
  category        String?
  method          String?
  important       Boolean  @default(false)
  calendarExported Boolean @default(false)
  status          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([duoId])
}
