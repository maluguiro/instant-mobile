{
  "expo": {
    "name": "instant-mobile",
    "slug": "instant-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/imagenes/icono-instant.png",
    "scheme": "instantmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#D97A5B",
        "foregroundImage": "./src/imagenes/icono-instant.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.maleguiro.instant"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a4f6751b-87e4-444a-915e-dfaccfcf6899"
      }
    },
    "owner": "maleguiro"
  }
}
