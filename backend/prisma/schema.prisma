generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  passwordHash   String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  categories     Category[]
  duoMemberships DuoMember[]
  methods        PaymentMethod[]
  transactions   Transaction[]
}

model Duo {
  id           String          @id @default(cuid())
  code         String          @unique
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  closedAt     DateTime?
  closedById   String?
  categories   Category[]
  members      DuoMember[]
  methods      PaymentMethod[]
  transactions Transaction[]
}

model DuoMember {
  id        String   @id @default(cuid())
  duoId     String
  userId    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  duo       Duo      @relation(fields: [duoId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([duoId, userId])
}

model Transaction {
  id        String          @id @default(cuid())
  userId    String
  type      TransactionType
  amount    Float
  currency  String
  category  String
  date      DateTime
  method    String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  note      String?
  weekly    Boolean         @default(false)
  duoId     String?
  duo       Duo?            @relation(fields: [duoId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([duoId])
}

model Category {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  duoId     String?
  duo       Duo?     @relation(fields: [duoId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@unique([duoId, name])
}

model PaymentMethod {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  duoId     String?
  duo       Duo?     @relation(fields: [duoId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@unique([duoId, name])
}

enum TransactionType {
  income
  expense
}
